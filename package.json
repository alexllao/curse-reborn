{
  "name": "curse-reborn",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Àlex Llaó",
    "email": "alexllao@me.com"
  },
  "description": "Reconstrucción de Curse of Enchantia desde su ejecutable DOS y futura remasterización con SDL.",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11 <12"
