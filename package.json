    "comparar:operaciones": "node herramientas/gestionar_proyecto.mjs comparar:operaciones",
    "comparar:altavoz": "node herramientas/gestionar_proyecto.mjs comparar:altavoz",
    "comparar:video": "node herramientas/gestionar_proyecto.mjs comparar:video",
    "comparar:rnc": "node herramientas/gestionar_proyecto.mjs comparar:rnc",
    "comparar:rnc2": "node herramientas/gestionar_proyecto.mjs comparar:rnc2",
    "comparar:escena": "node herramientas/gestionar_proyecto.mjs comparar:escena",
    "comparar:presentacion": "node herramientas/gestionar_proyecto.mjs comparar:presentacion",
    "titulo": "node herramientas/gestionar_proyecto.mjs titulo",
