# Recursos originales y resultados locales de investigación
/apps/juego/datos_originales/*
!/apps/juego/datos_originales/.gitkeep
!/apps/juego/datos_originales/README.md
# Copias locales anteriores, hasta migrarlas dentro del juego.
/datos_originales/
/recursos_extraidos/
/apps/juego/trabajo/
# Compatibilidad hasta trasladar el trabajo local de una copia anterior.
/trabajo/
*.zip
*.exe
*.com
*.sav

# Resultados de compilación
/node_modules/
**/node_modules/
/.pnpm-store/
/compilacion/
/build/
/cmake-build-*/
*.obj
*.o
*.pdb
*.ilk

# Archivos locales de editores y del sistema
/.vs/
/.vscode/
__pycache__/
*.pyc
Thumbs.db
.DS_Store

# Salidas locales de aplicaciones del workspace
/apps/*/dist/
/apps/*/build/
/packages/*/dist/

# Referencias comerciales y candidatos locales de remaster musical
/packages/assets/audio/musica/remaster/referencias/
/packages/assets/audio/musica/remaster/candidatas/*
