/trabajo/
*.zip
*.exe
*.com
*.sav

# Resultados de compilación
/node_modules/
**/node_modules/
/.pnpm-store/
/compilacion/
/build/
/cmake-build-*/
*.obj
*.o
*.pdb
*.ilk

# Archivos locales de editores y del sistema
/.vs/
/.vscode/
__pycache__/
*.pyc
Thumbs.db
.DS_Store

# Salidas locales de aplicaciones del workspace
/apps/*/dist/
/apps/*/build/
/packages/*/dist/
